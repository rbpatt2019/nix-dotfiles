layout {
    default_tab_template {
        pane size=2 borderless=true {
            plugin location="zjstatus" {
                hide_frame_for_single_pane "false"

                border_enabled  "true"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "bottom"

                format_left   "{mode}"
                format_center "{tabs}"
                format_right  "{datetime}"
                format_hide_on_overlength "true"
                format_precedence         "crl"

                // bar background 181926
                // widget grey background 363a4f
                // widgent black text 1e2030
                mode_normal        "#[fg=#a6da95,bg=#363a4f] NORMAL #[bg=#a6da95,fg=#1e2030] 󰿇 #[bg=#181926,fg=#a6da95,bold]"
                mode_locked        "#[fg=#6e738d,bg=#363a4f] LOCKED #[bg=#6e738d,fg=#1e2030]  #[bg=#181926,fg=#6e738d,bold]"
                mode_resize        "#[fg=#f38ba8,bg=#363a4f] RESIZE #[bg=#f38ba8,fg=#1e2030] 󰿇 #[bg=#181926,fg=#f38ba8,bold]"
                mode_pane          "#[fg=#89b4fa,bg=#363a4f] PANE   #[bg=#89b4fa,fg=#1e2030] 󰿇 #[bg=#181926,fg=#89b4fa,bold]"
                mode_tab           "#[fg=#b4befe,bg=#363a4f] TAB    #[bg=#b4befe,fg=#1e2030] 󰿇 #[bg=#181926,fg=#b4befe,bold]"
                mode_scroll        "#[fg=#f9e2af,bg=#363a4f] SCROLL #[bg=#f9e2af,fg=#1e2030] 󰿇 #[bg=#181926,fg=#f9e2af,bold]"
                mode_enter_search  "#[fg=#8aadf4,bg=#363a4f] ???    #[bg=#8aadf4,fg=#1e2030] 󰿇 #[bg=#181926,fg=#8aadf4,bold]"
                mode_search        "#[fg=#8aadf4,bg=#363a4f] SEARCH #[bg=#8aadf4,fg=#1e2030] 󰿇 #[bg=#181926,fg=#8aadf4,bold]"
                mode_rename_tab    "#[fg=#b4befe,bg=#363a4f] RE-TAB #[bg=#b4befe,fg=#1e2030] 󰿇 #[bg=#181926,fg=#b4befe,bold]"
                mode_rename_pane   "#[fg=#89b4fa,bg=#363a4f] RE-PAN #[bg=#89b4fa,fg=#1e2030] 󰿇 #[bg=#181926,fg=#89b4fa,bold]"
                mode_session       "#[fg=#74c7ec,bg=#363a4f] SESS'N #[bg=#74c7ec,fg=#1e2030] 󰿇 #[bg=#181926,fg=#74c7ec,bold]"
                mode_move          "#[fg=#f5c2e7,bg=#363a4f] MOVE   #[bg=#f5c2e7,fg=#1e2030] 󰿇 #[bg=#181926,fg=#f5c2e7,bold]"
                mode_prompt        "#[fg=#8aadf4,bg=#363a4f] PROMPT #[bg=#8aadf4,fg=#1e2030] 󰿇 #[bg=#181926,fg=#8aadf4,bold]"
                mode_tmux          "#[fg=#f5a97f,bg=#363a4f] TMUX   #[bg=#f5a97f,fg=#1e2030] 󰿇 #[bg=#181926,fg=#f5a97f,bold]"

                tab_normal              "#[bg=#181926,fg=#8bd5ca]#[bg=#8bd5ca,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#8bd5ca] {name}{floating_indicator}#[bg=#181926,fg=#363a4f,bold]"
                tab_normal_fullscreen   "#[bg=#181926,fg=#8bd5ca]#[bg=#8bd5ca,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#8bd5ca] {name}{fullscreen_indicator}#[bg=#181926,fg=#363a4f,bold]"
                tab_normal_sync         "#[bg=#181926,fg=#8bd5ca]#[bg=#8bd5ca,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#8bd5ca] {name}{sync_indicator}#[bg=#181926,fg=#363a4f,bold]"

                tab_active              "#[bg=#181926,fg=#f5a97f]#[bg=#f5a97f,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#f5a97f] {name}{floating_indicator}#[bg=#181926,fg=#363a4f,bold]"
                tab_active_fullscreen   "#[bg=#181926,fg=#f5a97f]#[bg=#f5a97f,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#f5a97f] {name}{fullscreen_indicator}#[bg=#181926,fg=#363a4f,bold]"
                tab_active_sync         "#[bg=#181926,fg=#f5a97f]#[bg=#f5a97f,fg=#1e2030,bold]{index} #[bg=#363a4f,fg=#f5a97f] {name}{sync_indicator}#[bg=#181926,fg=#363a4f,bold]"

                tab_separator           "#[bg=#181926] "

                tab_sync_indicator       "  "
                tab_fullscreen_indicator " 󰊓 "
                tab_floating_indicator   " 󰹙 "


                datetime "#[bg=#181926,fg=#89b4fa]#[bg=#89b4fa,fg=#1e2030]  #[bg=#363a4f,fg=#89b4fa] {format} "
                datetime_format "%H:%M %d.%m.%y"
                datetime_timezone "Europe/London"
            }
        }
        children
    }
    tab name="sys" {
        pane command="btop"
    }
    tab name="Work" focus=true {
        pane stacked=true {
            pane name="GEL" cwd="~/Projects"
            pane name="Personal" cwd="~/Projects/personal/"
        }
    }
    tab name="HPC" {
        pane command="ssh" {
            args "unicorn"
            start_suspended true
        }
    }
}
